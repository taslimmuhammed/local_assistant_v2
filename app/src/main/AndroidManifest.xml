<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used to download the model file. Inference itself is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice input. Images come from the photo picker, which needs no permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Reminders. Notifications are asked for the first time a reminder is made, not at install.
         Exact alarms are optional: without them a reminder may arrive a few minutes late. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- "Wake me up at 6", "timer for 10 minutes": set in the phone's own clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- "Call amma", "text Priya": asked the first time a name has to be looked up. Calls and
         messages are only prepared — the dialer or messaging app opens and the user presses the
         button — so neither CALL_PHONE nor SEND_SMS is needed. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Photo search: asked when the Photos screen is first opened, and only read. Android 14
         lets people share just some photos instead of all of them. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- "Photos in Munnar": where photos were taken. Android removes it from what the app reads
         unless this is granted; asked on the Photos screen. Matched against a place list in the
         APK, so no location leaves the phone. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- A place reminder, when the app isn't the phone's digital assistant: a foreground service
         keeps the app awake so it rings on arrival with the screen off. As the assistant, the
         system keeps the app up itself, and the service doesn't run. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- "Hey Luna": the same service listens for the wake word when that is turned on (off
         by default). Heard on the phone, by a small model in the APK; the audio goes nowhere. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- "How many steps today?", "how did I sleep?": read from Health Connect, where the phone's
         health apps (Fitbit, OHealth, a watch's app) keep them. Read only, nothing is written;
         each kind is asked for the first time it is asked about, or from Settings → Health data.
         What is read stays on the phone. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- "Remind me to buy milk near DMart": asked the first time a place reminder is made. Precise
         location finds "here" and the nearest branches; all the time lets Android ring the reminder
         on arrival with the app closed (geofences). The location stays on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- A place alarm takes the whole screen of a locked phone, as the clock's alarms do. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- "Turn on Do Not Disturb": the user still has to allow it in Settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- open_app: the apps with a launcher icon, which is what the user can name. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Health Connect as an app, on Android 13 and earlier. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".AssistantApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAssistant">

        <!-- Required for the LiteRT-LM GPU backend. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LocalAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the app icon: "Talk to assistant". -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- The assistant overlay. Handling ASSIST is what lets the user pick this app as the
             phone's digital assistant, which holding the power button then opens. Its own task,
             kept out of Recents, so it floats over whatever app was open and leaves no trace. -->
        <activity
            android:name=".assist.AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.local.assistant.assist"
            android:theme="@style/Theme.LocalAssistant.Assist"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- How health data is used: Health Connect shows its permission screen only to an app
             with this page, and links to it from there. Android 13 and earlier open it with the
             action below; 14 and later through the alias, which only the system may start. -->
        <activity
            android:name=".health.HealthPrivacyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LocalAssistant">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".health.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.HealthPrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- "While you were away": a pane of glass at the bottom of the screen, opened after an
             unlock (through the assistant session, as a background app can't open a screen) or
             from its notification. Its own task, out of Recents, like the overlay. -->
        <activity
            android:name=".away.BriefActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.local.assistant.away"
            android:theme="@style/Theme.LocalAssistant.Brief"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!-- A place alarm ringing on a locked or sleeping phone: the whole screen, over the lock
             screen, opened by its notification. See-through like the overlay, so what's behind
             shows frosted. Its own task, out of Recents. -->
        <activity
            android:name=".reminders.PlaceAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.local.assistant.alarm"
            android:theme="@style/Theme.LocalAssistant.Assist"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!-- Reads incoming notifications for "While you were away", once the user has turned it on
             and given the app notification access in Android's settings. What it keeps stays on
             the phone, in its own database, for two days. Only the system can bind it. -->
        <service
            android:name=".away.MessageListener"
            android:exported="false"
            android:label="@string/away_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Music, navigation, downloads in progress: never wanted, so never sent. -->
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>

        <!-- The digital assistant as Android runs one: holding the power button asks it for a
             session, which opens the overlay above, and the wake word asks for one too, which a
             background app couldn't otherwise do. Only the system can bind these. -->
        <service
            android:name=".assist.AssistantInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assist.AssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".assist.AssistantRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <service
            android:name=".assist.KeepReadyService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the app awake while a place reminder is set so it rings on arrival with the screen off" />
        </service>

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.EventReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.PlaceReminderReceiver" android:exported="false" />

        <!-- Only the system can send these, so exporting the receiver lets nothing else in. -->
        <receiver android:name=".reminders.RescheduleReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Screenshots shared to WhatsApp, email or messages (device/AndroidPhone): read only by
             the app they're sent to, for the one file, through a grant on the share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
