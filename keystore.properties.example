# Copy to keystore.properties (kept out of git) once the upload key exists, and fill in the two
# passwords. app/build.gradle.kts signs release builds with it. Paths are from the project root.
# Make the key with:
#   keytool -genkeypair -v -keystore upload-key.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
# Back up upload-key.jks and the passwords somewhere other than this Mac: Play needs this key for
# every update (a lost one can be replaced through Play support, which takes days).
storeFile=upload-key.jks
storePassword=
keyAlias=upload
keyPassword=
